# Public DIA storefront configuration
NDEVSCRAP_DIA_BASE_URL=https://diaonline.supermercadosdia.com.ar
# NDEVSCRAP_CONTACT=engineering@example.com

# HTTP transport shared by every store (defaults shown).
# Timeout in (0, 300] seconds, rate in (0, 2] requests per second,
# retries in [0, 10] and the longest Retry-After honored in (0, 3600] seconds.
NDEVSCRAP_HTTP_TIMEOUT_SECONDS=20
NDEVSCRAP_HTTP_REQUESTS_PER_SECOND=1
NDEVSCRAP_HTTP_MAX_RETRIES=3
NDEVSCRAP_HTTP_MAX_RETRY_AFTER_SECONDS=120

# Authorized ClubDIA integration. Never commit the referenced file.
# The session is read only when this variable is set.
# NDEVSCRAP_DIA_SESSION_FILE=.secrets/dia-session.json
